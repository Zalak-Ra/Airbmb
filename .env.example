# Copy to `.env` for local development. Never commit `.env`.

# Prisma uses DATABASE_URL at runtime (may be a pooler in production).
DATABASE_URL="postgresql://air:air@localhost:5432/air"

# Migrations need a direct (non-PgBouncer) connection. Locally this is the
# same URL. On Neon, use the host *without* `-pooler` and port 5432.
DIRECT_DATABASE_URL="postgresql://air:air@localhost:5432/air"

# TCP Redis — Docker Compose, Render, Fly.io.
REDIS_URL="redis://localhost:6379"

# Upstash REST — preferred on Vercel because serverless cannot hold a TCP
# connection. When both are set, REST wins.
# UPSTASH_REDIS_REST_URL="https://….upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# Teaching switch: floor under API latency so skeletons stay demonstrable.
# AIR_LATENCY_MS=250
